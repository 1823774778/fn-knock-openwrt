#!/bin/sh /etc/rc.common

USE_PROCD=1
START=90
STOP=10

GATEWAY_BIN=/usr/lib/fn-knock/bin/go-reauth-proxy
PROG=/usr/bin/node
APP_HOME=/opt/fn-knock
BACKEND_ENTRY="${APP_HOME}/server/server-admin/index.js"

BACKEND_PORT=7998
GO_BACKEND_PORT=7996
GO_REPROXY_PORT=7998
CONFIG_FILE=/etc/config/fn-knock

load_config() {
  local port
  local data_dir
  local redis_host
  local redis_port
  local redis_db
  local runtime_target

  config_load fn-knock

  config_get port main port 7998
  config_get data_dir main data_dir /var/lib/fn-knock
  config_get redis_host main redis_host 127.0.0.1
  config_get redis_port main redis_port 6379
  config_get redis_db main redis_db 0
  config_get runtime_target main runtime_target openwrt
  config_get gateway_port main gateway_port 7999
  config_get admin_port main admin_port 7996

  BACKEND_PORT="${port}"
  GO_REPROXY_PORT="${gateway_port:-7999}"
  GO_BACKEND_PORT="${admin_port:-7996}"

  export FN_KNOCK_RUNTIME_TARGET="${runtime_target}"
  export FN_KNOCK_DATA_DIR="${data_dir}"
  export FN_KNOCK_GATEWAY_CONFIG_DIR="${data_dir}/gateway"
  export FN_KNOCK_SERVICE_PORT="${port}"
  export FN_KNOCK_REDIS_HOST="${redis_host}"
  export FN_KNOCK_REDIS_PORT="${redis_port}"
  export FN_KNOCK_REDIS_DB="${redis_db}"
  export FN_KNOCK_RESOURCE_DIR="${APP_HOME}/resources"
  export TZ=Asia/Shanghai
}

ensure_dirs() {
  local data_dir="${FN_KNOCK_DATA_DIR:-/var/lib/fn-knock}"
  mkdir -p \
    "${data_dir}" \
    "${data_dir}/frp" \
    "${data_dir}/frp/instances" \
    "${data_dir}/cloudflared" \
    "${data_dir}/updates" \
    "${data_dir}/gateway" \
    /var/log/fn-knock
}

start_gateway() {
  local data_dir="${FN_KNOCK_DATA_DIR:-/var/lib/fn-knock}"

  if [ ! -x "${GATEWAY_BIN}" ]; then
    echo "ERROR: Gateway binary not found at ${GATEWAY_BIN}"
    return 1
  fi

  echo "Starting fn-knock gateway..."

  procd_open_instance gateway
  procd_set_param command "${GATEWAY_BIN}" \
    -c "${data_dir}/gateway" \
    -admin-port "${GO_BACKEND_PORT}" \
    -proxy-port "${GO_REPROXY_PORT}"
  procd_set_param respawn 3600 5 10
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_close_instance
}

start_backend() {
  echo "Starting fn-knock backend on port ${BACKEND_PORT}..."

  procd_open_instance backend
  procd_set_param command "${PROG}" "${BACKEND_ENTRY}"
  procd_set_param respawn 3600 5 10
  procd_set_param env NODE_ENV=production
  procd_set_param env FN_KNOCK_RUNTIME_TARGET="${FN_KNOCK_RUNTIME_TARGET}"
  procd_set_param env FN_KNOCK_DATA_DIR="${FN_KNOCK_DATA_DIR}"
  procd_set_param env FN_KNOCK_GATEWAY_CONFIG_DIR="${FN_KNOCK_GATEWAY_CONFIG_DIR}"
  procd_set_param env FN_KNOCK_SERVICE_PORT="${FN_KNOCK_SERVICE_PORT}"
  procd_set_param env FN_KNOCK_REDIS_HOST="${FN_KNOCK_REDIS_HOST}"
  procd_set_param env FN_KNOCK_REDIS_PORT="${FN_KNOCK_REDIS_PORT}"
  procd_set_param env FN_KNOCK_REDIS_DB="${FN_KNOCK_REDIS_DB}"
  procd_set_param env FN_KNOCK_RESOURCE_DIR="${FN_KNOCK_RESOURCE_DIR}"
  procd_set_param env TZ=Asia/Shanghai
  procd_set_param env BACKEND_PORT="${BACKEND_PORT}"
  procd_set_param env GO_BACKEND_PORT="${GO_BACKEND_PORT}"
  procd_set_param env GO_REPROXY_PORT="${GO_REPROXY_PORT}"
  procd_set_param env GO_BACKEND_BASE_URL="http://127.0.0.1:${GO_BACKEND_PORT}"
  procd_set_param env ADMIN_STATIC_PATH="${APP_HOME}/ui/www"
  procd_set_param env AUTH_STATIC_PATH="${APP_HOME}/server-auth-view/dist"
  procd_set_param env ACME_BUNDLE_ZIP="${APP_HOME}/resources/acmesh.zip"
  procd_set_param env HMAC_SECRET_FILE="${FN_KNOCK_DATA_DIR}/hmac_secret"
  procd_set_param user fn-knock
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_close_instance
}

start_service() {
  load_config
  ensure_dirs

  if ! pgrep -x redis-server > /dev/null; then
    /etc/init.d/redis start 2>/dev/null || echo "Warning: redis-server not running"
  fi

  start_gateway
  start_backend
}

stop_service() {
  procd_kill
}

service_triggers() {
  procd_add_reload_trigger fn-knock
}

reload_service() {
  stop
  start
}